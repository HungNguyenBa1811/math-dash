<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Screen"
    android:orientation="vertical"
    tools:context=".view.MatchDetailActivity">

    <LinearLayout style="@style/Band">

        <LinearLayout style="@style/TopBar">

            <TextView
                style="@style/TopBarTitle"
                android:text="@string/title_match_detail" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/Lane" />

    <LinearLayout
        style="@style/Content"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_l">

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitle"
                style="@style/Text.Small.Dim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Trận #37 · 25/10/2026 20:15" />

            <TextView
                android:id="@+id/txtResult"
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                tools:text="THẮNG!"
                tools:textColor="@color/win" />

            <TextView
                android:id="@+id/txtPoints"
                style="@style/Text.Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textSize="18sp"
                tools:text="+1 điểm" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_m"
                android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/space_s">

                    <TextView
                        android:id="@+id/txtMyName"
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/primary_text"
                        android:textStyle="bold"
                        tools:text="HÙNG" />

                    <TextView
                        android:id="@+id/txtMyStats"
                        style="@style/Text.Small.Dim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        tools:text="10/10 câu · 38,2 giây" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_s">

                    <TextView
                        android:id="@+id/txtOpponentName"
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textStyle="bold"
                        tools:text="HOÀNG" />

                    <TextView
                        android:id="@+id/txtOpponentStats"
                        style="@style/Text.Small.Dim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        tools:text="8/10 câu · 45,6 giây" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_s"
            android:text="@string/detail_problems" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_s">

            <TextView
                style="@style/Text.Label"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:text="#" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:text="@string/col_question" />

            <TextView
                android:id="@+id/txtMyColumn"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/primary_text"
                tools:text="HÙNG" />

            <TextView
                android:id="@+id/txtOpponentColumn"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                tools:text="HOÀNG" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProblems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_l" />
    </LinearLayout>
</LinearLayout>
