<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Row.Clickable"
    android:paddingStart="@dimen/space_m">

    <View
        android:id="@+id/viewResultBar"
        android:layout_width="6dp"
        android:layout_height="40dp"
        android:layout_marginEnd="@dimen/space_m"
        android:background="@drawable/bg_result_bar"
        tools:backgroundTint="@color/win" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtOpponent"
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="bold"
                tools:text="vs HOÀNG · #37" />

            <TextView
                android:id="@+id/txtResult"
                style="@style/Text.Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_marginEnd="@dimen/space_m"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                tools:text="THẮNG" />

            <TextView
                android:id="@+id/txtPoints"
                style="@style/Text.Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body"
                tools:text="+1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtScore"
                style="@style/Text.Small.Dim"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="10 – 8 câu" />

            <TextView
                android:id="@+id/txtEndedAt"
                style="@style/Text.Small.Dim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="25/10 20:15" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
