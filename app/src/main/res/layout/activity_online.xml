<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Screen"
    android:orientation="vertical"
    tools:context=".view.OnlineActivity">

    <LinearLayout style="@style/Band">

        <LinearLayout style="@style/TopBar">

            <TextView
                style="@style/TopBarTitle"
                android:text="@string/title_online" />

            <ImageButton
                android:id="@+id/btnHistory"
                style="@style/IconButton"
                android:contentDescription="@string/desc_history"
                android:src="@drawable/ic_history" />

            <ImageButton
                android:id="@+id/btnRanking"
                style="@style/IconButton"
                android:contentDescription="@string/desc_ranking"
                android:src="@drawable/ic_ranking" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/Lane" />

    <LinearLayout style="@style/Content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bib"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_xl"
            android:paddingTop="@dimen/space_l"
            android:paddingEnd="@dimen/space_xl"
            android:paddingBottom="@dimen/space_l">

            <TextView
                android:id="@+id/txtMyName"
                style="@style/Text.Display"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textSize="28sp"
                tools:text="HÙNG" />

            <TextView
                android:id="@+id/txtMyPoints"
                style="@style/Text.Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:textSize="22sp"
                tools:text="12,5 điểm" />
        </LinearLayout>

        <TextView
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_s"
            android:text="@string/title_online_players" />

        <TextView
            android:id="@+id/txtEmpty"
            style="@style/Text.Dim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="@dimen/space_xl"
            android:text="@string/msg_no_online"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlayers"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_l" />
    </LinearLayout>
</LinearLayout>
