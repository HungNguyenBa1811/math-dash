<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arcade_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:layout_margin="16dp"
    tools:context=".view.OnlineActivity">

    <!-- Thanh trên: tiêu đề, nút Lịch sử đấu, Bảng xếp hạng ở góc phải -->
    <LinearLayout style="@style/TopBar">

        <TextView
            style="@style/TopBarTitle"
            android:text="@string/title_online" />

        <ImageButton
            android:id="@+id/btnHistory"
            style="@style/IconButton"
            android:contentDescription="@string/desc_history"
            android:src="@drawable/ic_history" />

        <ImageButton
            android:id="@+id/btnRanking"
            style="@style/IconButton"
            android:contentDescription="@string/desc_ranking"
            android:src="@drawable/ic_ranking" />
    </LinearLayout>

    <!-- Thông tin của mình: tên, tổng điểm -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_retro_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtMyName"
            style="@style/RetroText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/arcade_cyan"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="HUNG" />

        <TextView
            android:id="@+id/txtMyPoints"
            style="@style/RetroText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/arcade_amber"
            tools:text="12,5 điểm" />
    </LinearLayout>

    <TextView
        style="@style/RetroText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="@string/title_online_players"
        android:textColor="@color/arcade_cyan"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtEmpty"
        style="@style/RetroText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_retro_card"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/msg_no_online"
        android:textColor="@color/arcade_text_dim"
        android:visibility="gone" />

    <!-- Danh sách người chơi online, bấm vào tên để thách đấu -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlayers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
