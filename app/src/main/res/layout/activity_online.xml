<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arcade_bg"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".view.OnlineActivity">

    <TextView
        style="@style/RetroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/title_online" />

    <Button
        android:id="@+id/btnCreateRoom"
        style="@style/RetroButton.Accent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="@string/btn_create_room" />

    <TextView
        style="@style/RetroText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/label_or"
        android:textColor="@color/arcade_text_dim" />

    <EditText
        android:id="@+id/edtRoomCode"
        style="@style/RetroInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:hint="@string/hint_room_code"
        android:inputType="number"
        android:maxLength="6"
        android:textSize="22sp" />

    <Button
        android:id="@+id/btnJoinRoom"
        style="@style/RetroButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_join_room" />

</LinearLayout>
