<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Screen"
    android:orientation="vertical"
    tools:context=".view.MainActivity">

    <LinearLayout
        style="@style/Band"
        android:paddingBottom="@dimen/space_xxl">

        <LinearLayout style="@style/TopBar">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnLogout"
                style="@style/IconButton"
                android:contentDescription="@string/btn_logout"
                android:src="@drawable/ic_logout" />
        </LinearLayout>

        <TextView
            style="@style/Text.Brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/txtMyName"
            style="@style/Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/on_band_dim"
            tools:text="Xin chào, HÙNG" />
    </LinearLayout>

    <View style="@style/Lane" />

    <LinearLayout
        style="@style/Content"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingBottom="@dimen/space_xxxl">

        <Button
            android:id="@+id/btnPlayBot"
            style="@style/Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_big_height"
            android:text="@string/btn_play_bot"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnPlayOnline"
            style="@style/Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_big_height"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/btn_play_online"
            android:textSize="22sp" />
    </LinearLayout>

</LinearLayout>
