<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arcade_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:layout_margin="16dp"
    tools:context=".view.MainActivity">

    <!-- Thanh trên: nút đăng xuất ở góc phải -->
    <LinearLayout style="@style/TopBar">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnLogout"
            style="@style/IconButton"
            android:contentDescription="@string/btn_logout"
            android:src="@drawable/ic_logout" />
    </LinearLayout>

    <!-- 2 chế độ chơi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            style="@style/RetroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/txtMyName"
            style="@style/RetroText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/arcade_text_dim"
            tools:text="Xin chào, HUNG" />

        <Button
            android:id="@+id/btnPlayBot"
            style="@style/RetroButton"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_retro_button_secondary"
            android:text="@string/btn_play_bot"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnPlayOnline"
            style="@style/RetroButton.Accent"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:text="@string/btn_play_online"
            android:textSize="20sp" />
    </LinearLayout>

</LinearLayout>
