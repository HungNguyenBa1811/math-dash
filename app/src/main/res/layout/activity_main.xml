<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arcade_bg"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".view.MainActivity">

    <TextView
        style="@style/RetroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/txtDisplayName"
        style="@style/RetroText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:textColor="@color/arcade_amber"
        tools:text="Xin chào, HUNG" />

    <Button
        android:id="@+id/btnPlayOffline"
        style="@style/RetroButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_play_offline" />

    <Button
        android:id="@+id/btnPlayOnline"
        style="@style/RetroButton.Accent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_play_online" />

    <Button
        android:id="@+id/btnHistory"
        style="@style/RetroButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_history" />

    <Button
        android:id="@+id/btnSettings"
        style="@style/RetroButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_settings" />

    <Button
        android:id="@+id/btnLogout"
        style="@style/RetroButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_logout" />

</LinearLayout>
