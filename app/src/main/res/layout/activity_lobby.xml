<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arcade_bg"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".view.LobbyActivity">

    <TextView
        style="@style/RetroText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_room_code"
        android:textColor="@color/arcade_text_dim" />

    <TextView
        android:id="@+id/txtRoomCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.2"
        android:textColor="@color/arcade_cyan"
        android:textSize="36sp"
        android:textStyle="bold"
        tools:text="482915" />

    <TextView
        style="@style/RetroText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_share_code"
        android:textColor="@color/arcade_text_dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtStatus"
        style="@style/RetroText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/status_waiting"
        android:textColor="@color/arcade_amber"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/txtOpponentName"
        style="@style/RetroText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/label_no_opponent" />

    <Button
        android:id="@+id/btnCancel"
        style="@style/RetroButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/btn_cancel" />

</LinearLayout>
