<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng danh sách quản trị: tên đăng nhập, tên hiển thị, tổng điểm, ngày tạo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_retro_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtUsername"
        style="@style/RetroText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="14sp"
        tools:text="hung" />

    <TextView
        android:id="@+id/txtDisplayName"
        style="@style/RetroText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/arcade_cyan"
        android:textSize="14sp"
        tools:text="HUNG" />

    <TextView
        android:id="@+id/txtPoints"
        style="@style/RetroText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:gravity="end"
        android:textSize="14sp"
        tools:text="12,5" />

    <TextView
        android:id="@+id/txtCreatedAt"
        style="@style/RetroText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:gravity="end"
        android:textColor="@color/arcade_text_dim"
        android:textSize="12sp"
        tools:text="20/10/2026" />

</LinearLayout>
