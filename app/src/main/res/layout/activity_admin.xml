<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Screen"
    android:orientation="vertical"
    tools:context=".view.AdminActivity">

    <LinearLayout style="@style/Band">

        <LinearLayout style="@style/TopBar">

            <TextView
                style="@style/TopBarTitle"
                android:text="@string/title_admin" />
        </LinearLayout>
    </LinearLayout>

    <View style="@style/Lane" />

    <LinearLayout
        style="@style/Content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="@dimen/space_xl">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnLogout"
            style="@style/Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_logout" />
    </LinearLayout>
</LinearLayout>
