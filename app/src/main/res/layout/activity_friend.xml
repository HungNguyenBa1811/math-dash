<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arcade_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".view.FriendActivity">

    <TextView
        style="@style/RetroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="@string/friend_title" />

    <!-- Gửi lời mời kết bạn bằng tên đăng nhập -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edtUsername"
            style="@style/RetroInput"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:hint="@string/friend_hint_username"
            android:importantForAutofill="no"
            android:inputType="text" />

        <Button
            android:id="@+id/btnAddFriend"
            style="@style/RetroButton.Accent"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/friend_btn_add" />
    </LinearLayout>

    <!-- Lời mời đã nhận: chỉ hiện khi có lời mời -->
    <TextView
        android:id="@+id/txtRequestsTitle"
        style="@style/RetroText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/arcade_amber"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Lời mời kết bạn (1)"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRequests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:nestedScrollingEnabled="false"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/txtFriendsTitle"
        style="@style/RetroText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/arcade_cyan"
        android:textStyle="bold"
        tools:text="Bạn bè (3)" />

    <TextView
        android:id="@+id/txtEmpty"
        style="@style/RetroText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_retro_card"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/friend_empty"
        android:textColor="@color/arcade_text_dim"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFriends"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
