<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arcade_bg"
    android:fitsSystemWindows="true"
    tools:context=".view.OnlineGameActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tầng 1: hàng điểm, điểm của mình bên trái (to, màu nhấn), không hiện tên -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtScorePopup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="invisible"
                    tools:text="+12" />

                <TextView
                    android:id="@+id/txtMyScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0"
                    android:textColor="@color/arcade_cyan"
                    android:textSize="44sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/RetroText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/label_vs"
                android:textColor="@color/arcade_text_dim" />

            <TextView
                android:id="@+id/txtOpponentScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="center_horizontal"
                android:text="0"
                android:textColor="@color/arcade_text_bright"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- Tầng 2: đồng hồ -->
        <TextView
            android:id="@+id/txtTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="01:00"
            android:textColor="@color/arcade_amber"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Tầng 3: câu hỏi, số đang nhập hiện sau dấu = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtProblem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/arcade_text_bright"
                android:textSize="36sp"
                android:textStyle="bold"
                tools:text="12 + 7 = " />

            <TextView
                android:id="@+id/txtAnswer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="\?"
                android:textColor="@color/arcade_green"
                android:textSize="36sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tầng 4: bàn phím số 3x4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDigit1"
                style="@style/RetroButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="1"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnDigit2"
                style="@style/RetroButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="2"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnDigit3"
                style="@style/RetroButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="3"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDigit4"
                style="@style/RetroButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="4"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnDigit5"
                style="@style/RetroButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="5"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnDigit6"
                style="@style/RetroButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="6"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDigit7"
                style="@style/RetroButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="7"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnDigit8"
                style="@style/RetroButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="8"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnDigit9"
                style="@style/RetroButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="9"
                android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBackspace"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_retro_button"
                android:contentDescription="@string/desc_backspace"
                android:src="@drawable/ic_backspace" />

            <Button
                android:id="@+id/btnDigit0"
                style="@style/RetroButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="0"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnSubmit"
                style="@style/RetroButton.Accent"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/btn_ok"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Overlay kết quả: phủ lên màn thi đấu khi trận xong -->
    <LinearLayout
        android:id="@+id/layoutResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/arcade_overlay_dim"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textSize="44sp"
            android:textStyle="bold"
            tools:text="THẮNG!" />

        <TextView
            android:id="@+id/txtFinalScore"
            style="@style/RetroText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="28sp"
            tools:text="120 - 96" />

        <Button
            android:id="@+id/btnBackToMenu"
            style="@style/RetroButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/btn_back_to_menu" />
    </LinearLayout>

</FrameLayout>
