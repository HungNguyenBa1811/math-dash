<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Row"
    android:paddingStart="@dimen/space_m"
    android:paddingEnd="@dimen/space_m">

    <TextView
        android:id="@+id/txtIndex"
        style="@style/Text.Number"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:textColor="@color/ink_dim"
        android:textSize="@dimen/text_body"
        tools:text="1" />

    <TextView
        android:id="@+id/txtExpression"
        style="@style/Text.Number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:textSize="18sp"
        tools:text="12 + 7 = 19" />

    <TextView
        android:id="@+id/txtMyAnswer"
        style="@style/Text.Small"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textStyle="bold"
        tools:text="✓ 19\n2,3 s"
        tools:textColor="@color/win" />

    <TextView
        android:id="@+id/txtOpponentAnswer"
        style="@style/Text.Small"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:textStyle="bold"
        tools:text="✗ 18\n4,1 s"
        tools:textColor="@color/lose" />
</LinearLayout>
