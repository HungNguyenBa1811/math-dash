<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Mathdash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/arcade_bg</item>
        <item name="android:statusBarColor">@color/arcade_bg</item>
        <item name="android:navigationBarColor">@color/arcade_bg</item>
    </style>

    <style name="Theme.Mathdash" parent="Base.Theme.Mathdash" />

    <!-- Nút kiểu arcade: bỏ màu tint của Material để dùng nền vẽ sẵn -->
    <style name="RetroButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_retro_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/arcade_text_bright</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="RetroButton.Accent">
        <item name="android:background">@drawable/bg_retro_button_accent</item>
        <item name="android:textColor">@color/arcade_bg</item>
    </style>

    <style name="RetroInput">
        <item name="android:background">@drawable/bg_retro_input</item>
        <item name="android:textColor">@color/arcade_text_bright</item>
        <item name="android:textColorHint">@color/arcade_text_dim</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:padding">14dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="RetroTitle">
        <item name="android:textColor">@color/arcade_cyan</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="RetroText">
        <item name="android:textColor">@color/arcade_text_bright</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Thanh trên cùng của mỗi màn: tiêu đề bên trái, nút biểu tượng bên phải -->
    <style name="TopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="TopBarTitle" parent="RetroTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">22sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">center</item>
    </style>

    <!-- Ô phương án A, B, C, D của màn thi đấu -->
    <style name="OptionTile" parent="RetroButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">30sp</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
