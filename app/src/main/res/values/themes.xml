<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Mathdash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/arcade_bg</item>
        <item name="android:statusBarColor">@color/arcade_bg</item>
        <item name="android:navigationBarColor">@color/arcade_bg</item>
    </style>

    <style name="Theme.Mathdash" parent="Base.Theme.Mathdash" />

    <!-- Nút kiểu arcade: bỏ màu tint của Material để dùng nền vẽ sẵn -->
    <style name="RetroButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_retro_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/arcade_text_bright</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="RetroButton.Accent">
        <item name="android:background">@drawable/bg_retro_button_accent</item>
        <item name="android:textColor">@color/arcade_bg</item>
    </style>

    <style name="RetroInput">
        <item name="android:background">@drawable/bg_retro_input</item>
        <item name="android:textColor">@color/arcade_text_bright</item>
        <item name="android:textColorHint">@color/arcade_text_dim</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:padding">14dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="RetroTitle">
        <item name="android:textColor">@color/arcade_cyan</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="RetroText">
        <item name="android:textColor">@color/arcade_text_bright</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Phương án trắc nghiệm -->
    <style name="RetroOption">
        <item name="android:textColor">@color/arcade_text_bright</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="buttonTint">@color/arcade_cyan</item>
    </style>
</resources>
