<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Mathdash" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/band</item>
        <item name="colorOnSecondary">@color/on_band</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_dim</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorError">@color/lose</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_dim</item>
        <item name="android:fontFamily">@font/body</item>
        <item name="fontFamily">@font/body</item>
        <item name="android:windowBackground">@color/band</item>
        <item name="android:statusBarColor">@color/band</item>
        <item name="android:navigationBarColor">@color/band</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Mathdash.Dialog</item>
    </style>

    <style name="Theme.Mathdash" parent="Base.Theme.Mathdash" />

    <style name="ThemeOverlay.Mathdash.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">@color/primary_text</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:fontFamily">@font/body</item>
        <item name="fontFamily">@font/body</item>
    </style>

    <style name="Screen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/band</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Band">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/band</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/gutter</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
    </style>

    <style name="Lane">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/lane_height</item>
        <item name="android:background">@drawable/bg_lane</item>
        <item name="android:layerType">software</item>
    </style>

    <style name="Content">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@color/bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/gutter</item>
        <item name="android:paddingEnd">@dimen/gutter</item>
        <item name="android:paddingTop">@dimen/space_xl</item>
    </style>

    <style name="TopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/top_bar_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="TopBarTitle" parent="Text.Title">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">@dimen/touch</item>
        <item name="android:layout_height">@dimen/touch</item>
        <item name="android:layout_marginStart">@dimen/space_s</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/on_band</item>
    </style>

    <style name="TextAppearance.Mathdash.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/display</item>
        <item name="fontFamily">@font/display</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Text">
        <item name="android:fontFamily">@font/body</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Text.Dim">
        <item name="android:textColor">@color/ink_dim</item>
    </style>

    <style name="Text.Small">
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <style name="Text.Small.Dim">
        <item name="android:textColor">@color/ink_dim</item>
    </style>

    <style name="Text.Label">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink_dim</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Number">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">@dimen/text_headline</item>
    </style>

    <style name="Text.Title">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/on_band</item>
    </style>

    <style name="Text.Display">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Brand" parent="Text.Display">
        <item name="android:textSize">@dimen/text_brand</item>
        <item name="android:textColor">@color/on_band</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:lineSpacingMultiplier">0.85</item>
    </style>

    <style name="Button" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/on_band</item>
    </style>

    <style name="Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_dim</item>
        <item name="android:fontFamily">@font/body</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_l</item>
    </style>

    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:paddingTop">@dimen/space_m</item>
        <item name="android:paddingBottom">@dimen/space_m</item>
    </style>

    <style name="Row.Clickable">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">@drawable/fg_row_ripple</item>
    </style>

    <style name="OptionTile" parent="Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_tile</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingMultiplier">0.85</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">@dimen/space_s</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">16sp</item>
        <item name="autoSizeMaxTextSize">@dimen/text_tile</item>
        <item name="autoSizeStepGranularity">2sp</item>
    </style>

</resources>
