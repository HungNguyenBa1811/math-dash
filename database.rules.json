{
  "rules": {
    "presence": {
      ".read": true,
      "$playerId": {
        ".write": true,
        ".validate": "!newData.exists() || newData.hasChildren(['displayName', 'status'])",
        "displayName": {
          ".validate": "newData.isString()"
        },
        "totalPoints": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "status": {
          ".validate": "newData.val() === 'free' || newData.val() === 'busy'"
        }
      }
    },
    "challenges": {
      ".read": true,
      ".indexOn": ["opponentId"],
      "$challengeId": {
        ".write": true,
        "status": {
          ".validate": "newData.val() === 'pending' || newData.val() === 'accepted' || newData.val() === 'rejected'"
        },
        "challengerId": {
          ".validate": "newData.isNumber()"
        },
        "opponentId": {
          ".validate": "newData.isNumber() && newData.val() !== newData.parent().child('challengerId').val()"
        }
      }
    },
    "matches": {
      ".read": true,
      "$matchId": {
        ".write": true,
        "status": {
          ".validate": "newData.val() === 'playing' || newData.val() === 'finished'"
        }
      }
    }
  }
}
