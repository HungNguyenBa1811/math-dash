@startuml tuan-tu-thiet-ke-uc03a
!include _seq.iuml
title Tuần tự thiết kế – Chơi online, đoạn A: Gửi lời thách đấu

actor "Người chơi" as U
box "Client (Android)" #FFFFFF
boundary "MainActivity" as MA
boundary "OnlineActivity" as OA
boundary "MatchActivity" as GA
control "SessionDAO" as SD
control "PresenceFirebaseDAO" as PFD
control "ChallengeFirebaseDAO" as CFD
control "PlayerApiDAO" as PAD
entity "Player" as P
entity "Challenge" as C
end box
box "Server (Spring Boot)" #FFFFFF
boundary "PlayerRestController" as PRC
control "PlayerDAO" as PD
entity "Player" as SP
end box

U -> MA : nhấn Chơi online
MA -> OA : onClick()
OA -> SD : getPlayer()
SD -> P : call
P -> P : Player()
P --> SD : return
SD --> OA : return
OA ->> PFD : watchOnlinePlayers()
OA ->> CFD : watchIncoming()
OA -> OA : goOnline()
OA -> PAD : getById() {Thread}
PAD -> PRC : GET /api/players/{id} → getById()
PRC -> PD : findById()
PD -> SP : call
SP -> SP : Player()
SP --> PD : return
PD --> PRC : return
PRC -> PD : getTotalPoints()
PD --> PRC : return
PRC --> PAD : return
PAD -> P : call
P -> P : Player()
P --> PAD : return
PAD --> OA : return
OA -> PFD : goOnline()
PFD -> PFD : onDataChange()
PFD -> P : call
P -> P : Player()
P --> PFD : return
PFD -> OA : onPlayersChanged() {PlayerListCallback}
OA --> U : display
U -> OA : bấm vào tên đối thủ
OA -> OA : onClick()
OA -> CFD : sendChallenge()
CFD -> C : call
C -> C : Challenge(), setChallenger(), setOpponent()
C --> CFD : return
CFD --> OA : return
OA ->> CFD : watchChallenge()
OA --> U : display
CFD -> CFD : onDataChange()
CFD -> C : call
C -> C : Challenge()
C --> CFD : return
CFD -> OA : onChallengeChanged() {ChallengeCallback}
OA -> OA : closeSentChallenge()
OA -> CFD : stopWatchingSent()
OA -> GA : openMatch()
GA --> U : display
@enduml
