@startuml tuan-tu-thiet-ke-uc05c
!include _seq.iuml
title Tuần tự thiết kế – Chơi online, đoạn C: Thi đấu và kết thúc trận

actor "Người chơi" as U
box "Client (Android)" #FFFFFF
boundary MainActivity as MA
boundary OnlineGameActivity as GA
control MatchController as MC
control CountDownTimer as T
control ProblemDAO as PD
control MatchFirebaseDAO as MFD
control MatchApiDAO as MAD
entity GameSession as GS
entity MathProblem as MP
entity Match as M
end box
box "Server (Spring Boot)" #FFFFFF
boundary MatchRestController as MRC
control FirebaseAdminDAO as FAD
control MatchDAO as MD
entity "Match" as SM
end box

GA -> MC : onCreate(): startGame()
MC -> MFD : registerDisconnect()
MC -> PD : tạo ProblemDAO
MC -> GS : tạo GameSession
MC -> MFD : watchMatch()
MC -> T : start()
MC -> GS : getCurrentLevel()
GS --> MC : mức hiện tại
MC -> PD : generateProblem()
PD -> MP : đóng gói MathProblem
MP --> PD : MathProblem
PD --> MC : MathProblem
MC --> GA : MathProblem
GA --> U : hiển thị điểm, đồng hồ, câu hỏi, bàn phím số

loop đến khi CountDownTimer hết giờ
  T -> MC : onTick()
  MC -> GA : onTick()
  GA --> U : hiển thị thời gian còn lại
  U -> GA : nhập đáp án, nhấn OK
  GA -> MC : onClick(): submitAnswer()
  MC -> MP : isCorrect()
  MP --> MC : true
  MC -> GS : recordCorrectAnswer()
  GS --> MC : điểm được cộng
  MC -> MFD : updateScore()
  MC --> GA : điểm được cộng
  GA -> MC : nextProblem()
  MC -> GS : getCurrentLevel()
  GS --> MC : mức hiện tại
  MC -> PD : generateProblem()
  PD -> MP : đóng gói MathProblem
  MP --> PD : MathProblem
  PD --> MC : MathProblem
  MC --> GA : MathProblem
  GA --> U : showScorePopup(): điểm mới, câu hỏi mới
  MFD -> MFD : onDataChange(): toMatch()
  MFD -> M : đóng gói Match
  M --> MFD : Match
  MFD -> MC : onSuccess()
  MC -> M : isOver()
  M --> MC : false
  MC -> GA : onMatchChanged()
  GA --> U : hiển thị điểm đối thủ
end

T -> MC : onFinish()
MC -> MFD : setTimeUp()
MC -> GA : onTimeUp()
GA --> U : khóa bàn phím, hiển thị thông báo chờ kết quả
MFD -> MFD : onDataChange(): toMatch()
MFD -> M : đóng gói Match
M --> MFD : Match
MFD -> MC : onSuccess()
MC -> M : isOver()
M --> MC : true
MC -> MC : finishMatch() {Thread}
MC -> MAD : finishMatch()
MAD -> MRC : POST /api/matches/{roomCode}/finish → finish()
MRC -> FAD : readMatch()
FAD -> SM : đóng gói Match
SM --> FAD : Match
FAD --> MRC : Match
MRC -> SM : isOver()
SM --> MRC : true
MRC -> MD : insert()
MD -> MD : lưu trận trong một transaction
MD --> MRC : true
MRC -> FAD : updateStatus()
MRC --> MAD : Match (JSON)
MAD -> M : toMatch()
M --> MAD : Match
MAD --> MC : Match
MC -> MFD : stopWatching()
MC -> GA : runOnUiThread(): onMatchEnd()
GA -> M : showResult(): getResult()
M --> GA : kết quả
GA --> U : hiển thị kết quả, tỉ số
U -> GA : nhấn Về menu
GA -> MA : onClick(): finish()
MA --> U : hiển thị
@enduml
