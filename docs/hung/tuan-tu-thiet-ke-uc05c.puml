@startuml tuan-tu-thiet-ke-uc05c
!include _seq.iuml
title Tuần tự thiết kế – Chơi online, đoạn C: Thi đấu và kết thúc trận

actor "Người chơi" as U
box "Client (Android)" #FFFFFF
boundary MainActivity as MA
boundary OnlineGameActivity as GA
control CountDownTimer as T
control ProblemDAO as PD
control MatchFirebaseDAO as MFD
control MatchApiDAO as MAD
entity GameSession as GS
entity MathProblem as MP
entity Match as M
end box
box "Server (Spring Boot)" #FFFFFF
boundary MatchRestController as MRC
control FirebaseAdminDAO as FAD
control MatchDAO as MD
entity "Match" as SM
end box

GA -> MFD : onCreate(): watchMatch()
MFD -> MFD : onDataChange(): toMatch()
MFD -> M : đóng gói Match
M --> MFD : Match
MFD -> GA : onSuccess()
GA -> GA : startGame()
GA -> MFD : registerDisconnect()
GA -> PD : tạo ProblemDAO
GA -> GS : tạo GameSession
GA -> T : start()
GA -> GA : nextProblem()
GA -> GS : getCurrentLevel()
GS --> GA : mức hiện tại
GA -> PD : generateProblem()
PD -> MP : đóng gói MathProblem
MP --> PD : MathProblem
PD --> GA : MathProblem
GA -> M : isOver()
M --> GA : false
GA --> U : hiển thị điểm, đồng hồ, câu hỏi, bàn phím số

loop đến khi CountDownTimer hết giờ
  T -> GA : onTick()
  GA --> U : hiển thị thời gian còn lại
  U -> GA : nhập đáp án, nhấn OK
  GA -> GA : onClick(): submitAnswer()
  GA -> MP : isCorrect()
  MP --> GA : true
  GA -> GS : recordCorrectAnswer()
  GS --> GA : điểm được cộng
  GA -> MFD : updateScore()
  GA -> GA : nextProblem()
  GA -> GS : getCurrentLevel()
  GS --> GA : mức hiện tại
  GA -> PD : generateProblem()
  PD -> MP : đóng gói MathProblem
  MP --> PD : MathProblem
  PD --> GA : MathProblem
  GA --> U : showScorePopup(): điểm mới, câu hỏi mới
  MFD -> MFD : onDataChange(): toMatch()
  MFD -> M : đóng gói Match
  M --> MFD : Match
  MFD -> GA : onSuccess()
  GA -> M : isOver()
  M --> GA : false
  GA --> U : showOpponentScore(): điểm đối thủ
end

T -> GA : onFinish()
GA -> MFD : setTimeUp()
GA --> U : lockKeypad(): khóa bàn phím, chờ kết quả
MFD -> MFD : onDataChange(): toMatch()
MFD -> M : đóng gói Match
M --> MFD : Match
MFD -> GA : onSuccess()
GA -> M : isOver()
M --> GA : true
GA -> GA : finishMatch()
GA -> MFD : stopGame(): stopWatching()
GA -> MAD : finishMatch() {Thread}
MAD -> MRC : POST /api/matches/{roomCode}/finish → finish()
MRC -> FAD : readMatch()
FAD -> SM : đóng gói Match
SM --> FAD : Match
FAD --> MRC : Match
MRC -> SM : isOver()
SM --> MRC : true
MRC -> MD : insert()
MD -> MD : lưu trận trong một transaction
MD --> MRC : true
MRC -> FAD : updateStatus()
MRC --> MAD : Match (JSON)
MAD -> M : toMatch()
M --> MAD : Match
MAD --> GA : Match
GA -> GA : runOnUiThread(): showResult()
GA -> M : getResult()
M --> GA : kết quả
GA --> U : hiển thị kết quả, tỉ số
U -> GA : nhấn Về menu
GA -> MA : onClick(): finish()
MA --> U : hiển thị
@enduml
