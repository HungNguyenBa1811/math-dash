@startuml lop-thiet-ke-xem-bang-xep-hang
!include _theme.iuml
title Biểu đồ lớp chi tiết – Xem bảng xếp hạng

package "Client (Android)" as PC {
  class OnlineActivity <<boundary>> {
    + onCreate(savedInstanceState : Bundle) : void
    + onClick(v : View) : void
  }
  class HistoryActivity <<boundary>> {
    - me : Player
    + onCreate(savedInstanceState : Bundle) : void
    + onTabSelected(tab : Tab) : void
    - loadRanking() : void
  }
  class RankingAdapter <<boundary>> {
    - listPlayer : List<Player>
    - myId : int
    + onCreateViewHolder(parent : ViewGroup, viewType : int) : RankingViewHolder
    + onBindViewHolder(holder : RankingViewHolder, position : int) : void
    + getItemCount() : int
  }
  class RankingViewHolder <<boundary>>
  class "activity_online.xml" as xmlOnline
  class "activity_history.xml" as xmlHistory
  class "item_ranking.xml" as xmlItemRanking
  class SessionDAO <<control>> {
    - prefs : SharedPreferences
    + getPlayer() : Player
  }
  abstract class ApiDAO <<control>> {
    # getArray(path : String) : JSONArray
  }
  class PlayerApiDAO <<control>> {
    + getRanking() : List<Player>
    - toPlayer(json : JSONObject) : Player
  }
  class Player <<entity>> {
    - id : int
    - displayName : String
    - totalPoints : double
    - avgOpponentPoints : double
    - avgWinTime : double
  }
}

package "Bên thứ ba" as PT {
}

package "Server (Spring Boot)" as PS {
  class PlayerRestController <<boundary>> {
    + getRanking() : List<Player>
  }
  class PlayerDAO <<control>> {
    + getRanking() : List<Player>
    + rank(players : List<Player>, matches : List<Match>) : List<Player>
    - averageSeconds(times : List<Long>) : double
    - findAllPlayers() : List<Player>
  }
  class MatchDAO <<control>> {
    + findFinished() : List<Match>
  }
  abstract class "DAO" as SDAO <<control>> {
    # conn : Connection
    + DAO()
  }
  class "Player" as SPlayer <<entity>> {
    - id : int
    - displayName : String
    - totalPoints : double
    - avgOpponentPoints : double
    - avgWinTime : double
  }
  class "Match" as SMatch <<entity>> {
    - id : int
    - endedAt : Date
    - players : List<MatchPlayer>
    + getFinishTime(playerId : int) : long
    + getResult(playerId : int) : String
    + getPoints(playerId : int) : double
  }
  class "MatchPlayer" as SMatchPlayer <<entity>> {
    - id : int
    - submittedAt : Date
    - forfeited : boolean
    - player : Player
  }
}

OnlineActivity -- xmlOnline
OnlineActivity -- HistoryActivity
HistoryActivity -- xmlHistory
HistoryActivity -- RankingAdapter
HistoryActivity -- SessionDAO
HistoryActivity -- PlayerApiDAO
HistoryActivity o-- "1" Player
RankingAdapter -- RankingViewHolder
RankingViewHolder -- xmlItemRanking
RankingAdapter o-- "n" Player
PlayerApiDAO --|> ApiDAO
SessionDAO -- Player
PlayerApiDAO -- Player

PlayerRestController -- PlayerDAO
PlayerDAO -- MatchDAO
MatchDAO --|> SDAO
PlayerDAO --|> SDAO
MatchDAO -- SMatch
PlayerDAO -- SPlayer
PlayerDAO -- SMatch
SMatch "1" o-- "2" SMatchPlayer
SMatchPlayer "n" o-- "1" SPlayer

PlayerApiDAO -- PlayerRestController : HTTP/JSON

' Client trên, Bên thứ ba giữa, Server dưới
PC -[hidden]down- PT
PT -[hidden]down- PS
@enduml
