@startuml lop-thuc-the-hung
!pragma layout smetana
' === VP Base Theme v2 ===
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam arrowColor #000000
skinparam lineColor #000000
hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
  FontSize 11
  AttributeFontSize 10
  BorderThickness 1
}
left to right direction
title Lớp thực thể pha thiết kế – phần Chơi online, Xem lịch sử đấu

class Player {
  - id : int
  - username : String
  - passwordHash : String
  - displayName : String
  - role : String
  - createdAt : Date
  - totalPoints : double
  - avgOpponentPoints : double
  - avgWinTime : double
  - status : String
}
class MathProblem {
  - id : int
  - operand1 : int
  - operand2 : int
  - operator : String
  - correctAnswer : int
  - answerOptions : List<Integer>
  + isCorrect(answer : int) : boolean
  + getExpression() : String
}
class Challenge {
  - id : String
  - status : String
  - createdAt : Date
  - matchId : int
  - challenger : Player
  - opponent : Player
}
class Match {
  - id : int
  - status : String
  - startedAt : Date
  - endedAt : Date
  - questions : List<MathProblem>
  - players : List<MatchPlayer>
  + countCorrect(answers : List<Answer>) : int
  + isOver() : boolean
  + getFinishTime(playerId : int) : long
  + getResult(playerId : int) : String
  + getPoints(playerId : int) : double
  + getOpponent(playerId : int) : MatchPlayer
}
class MatchPlayer {
  - id : int
  - answers : List<Answer>
  - correctCount : int
  - submittedAt : Date
  - forfeited : boolean
  - player : Player
}
class Answer {
  + {static} NONE : int
  - id : int
  - selectedOption : int
  - answerTime : long
  - problem : MathProblem
  + isAnswered() : boolean
  + isCorrect() : boolean
}

Challenge "n" o-- "1" Player : challenger
Challenge "n" o-- "1" Player : opponent
Match "1" o-- "2" MatchPlayer
MatchPlayer "n" o-- "1" Player
Match "1" o-- "10" MathProblem
MatchPlayer "1" o-- "n" Answer
Answer "n" o-- "1" MathProblem
@enduml
