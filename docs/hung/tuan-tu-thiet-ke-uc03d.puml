@startuml tuan-tu-thiet-ke-uc03d
!include _seq.iuml
title Tuần tự thiết kế – Chơi online, đoạn D: Chơi tiếp

actor "Người chơi" as U
box "Client (Android)" #FFFFFF
boundary "MatchActivity" as GA
control "MatchFirebaseDAO" as MFD
control "MatchApiDAO" as MAD
entity "Match" as M
end box
box "Server (Spring Boot)" #FFFFFF
boundary "MatchRestController" as MRC
control "MatchDAO" as MD
control "ProblemDAO" as PRD
control "FirebaseAdminDAO" as FAD
entity "Match" as SM
entity "MathProblem" as SQ
end box

U -> GA : nhấn Chơi tiếp
GA -> GA : onClick()
GA -> MAD : continueMatch() {Thread}
MAD -> MRC : POST /api/matches/{id}/continue → continueMatch()
MRC -> MD : findById()
MD -> SM : call
SM -> SM : Match()
SM --> MD : return
MD --> MRC : return
MRC -> FAD : writeChoice()
MRC --> MAD : return
MAD -> M : call
M -> M : Match()
M --> MAD : return
MAD --> GA : return
GA --> U : display
MRC -> MRC : startMatch()
MRC -> SM : call
SM -> SM : Match()
SM --> MRC : return
MRC -> PRD : generateProblems()
PRD -> SQ : call
SQ -> SQ : MathProblem()
SQ --> PRD : return
PRD --> MRC : return
MRC -> MD : insert()
MD --> MRC : return
MRC -> FAD : writeMatch()
MRC -> FAD : updateStatus()
MRC -> FAD : writeNextMatch()
MFD -> GA : onNextMatch() {MatchCallback}
GA -> GA : openNextMatch()
GA -> MFD : stopWatching()
GA -> GA : startActivity()
GA --> U : display
@enduml
