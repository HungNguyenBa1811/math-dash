@startuml uc-chi-tiet-doi-khang
!pragma layout smetana
' === VP Base Theme v2 ===
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam arrowColor #000000
skinparam lineColor #000000
hide circle

skinparam usecase {
  BackgroundColor #7ACFF5
  BorderColor Black
  FontColor Black
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor Black
}

left to right direction
title Biểu đồ use case chi tiết module Đấu đối kháng – Math Dash 1v1

actor "Người chơi" as A1

rectangle "Module Đấu đối kháng" {
  usecase "Chơi online" as UC03
  usecase "Thách đấu" as TD
  usecase "Thi đấu" as TDAU
  usecase "Đăng nhập" as DN
}

A1 --> UC03

UC03 ..> DN : <<include>>
UC03 ..> TD : <<include>>
UC03 ..> TDAU : <<include>>
@enduml
