@startuml lop-phan-tich-uc03
!include _theme.iuml
title Biểu đồ lớp pha phân tích – Chơi online

class MainView <<boundary>> {
  - subPlayBot
  - subPlayOnline
}
class OnlineView <<boundary>> {
  - outMyInfo
  - outsubListPlayer
}
class MatchView <<boundary>> {
  - outTimer
  - outOpponentStatus
  - outQuestion
  - subOptions
  - subSubmit
  - subExit
}
class MatchResultView <<boundary>> {
  - outResult
  - outMyResult
  - outOpponentResult
  - outPoints
  - subContinue
  - subStop
}

class Player <<entity>> {
  - username
  - password
  - displayName
  - role
  - createdAt
  - totalPoints
  - status
  + goOnline()
  + getOnlinePlayers()
}
class Challenge <<entity>> {
  - status
  - createdAt
  + sendChallenge()
  + watchChallenge()
  + rejectChallenge()
}
class Match <<entity>> {
  - status
  - startedAt
  - endedAt
  + createMatch()
  + watchMatch()
  + submitAnswers()
  + isOver()
  + getResult()
  + getFinishTime()
  + getPoints()
  + forfeit()
  + continueMatch()
}
class MatchPlayer <<entity>> {
  - correctCount
  - submittedAt
  - forfeited
}
class Answer <<entity>> {
  - selectedOption
  - answerTime
  + isCorrect()
}
class MathProblem <<entity>> {
  - operand1
  - operand2
  - operator
  - correctAnswer
  - answerOptions
  + generateProblem()
  + isCorrect()
}

MainView -- OnlineView
OnlineView -- MatchView
MatchView -- MatchResultView
MatchResultView -- OnlineView
OnlineView -- Player
OnlineView -- Challenge
OnlineView -- Match
MatchView -- Match
MatchResultView -- Match
Challenge "n" o-- "1" Player : người mời
Challenge "n" o-- "1" Player : người được mời
Player "n" -- "n" Match
(Player, Match) .. MatchPlayer
Match "1" *-- "10" MathProblem
MatchPlayer "n" -- "n" MathProblem
(MatchPlayer, MathProblem) .. Answer
@enduml
