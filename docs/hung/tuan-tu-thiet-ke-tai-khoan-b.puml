@startuml tuan-tu-thiet-ke-tai-khoan-b
!include _seq.iuml
title Tuần tự thiết kế – Đăng nhập, đăng ký, đoạn B: Đăng nhập

actor "Người chơi" as U
box "Client (Android)" #FFFFFF
boundary LoginActivity as LA
boundary MainActivity as MA
control SessionDAO as SD
control PlayerApiDAO as PAD
control PlayerDAO as LPD
entity Player as P
end box
box "Server (Spring Boot)" #FFFFFF
boundary "AuthRestController" as ARC
control "PlayerDAO" as SPD
entity "Player" as SP
end box

U -> LA : mở ứng dụng
LA -> SD : onCreate(): getPlayer()
SD --> LA : null
LA --> U : hiển thị giao diện đăng nhập
U -> LA : nhập tên đăng nhập, mật khẩu, nhấn Đăng nhập
LA -> LA : onClick(): login()
LA -> PAD : login() {Thread}
PAD -> ARC : POST /api/auth/login → login()
ARC -> SPD : findByUsername()
SPD -> SP : đóng gói Player
SP --> SPD : Player
SPD --> ARC : Player
ARC -> ARC : so mật khẩu bằng BCrypt
ARC --> PAD : Player (JSON)
PAD -> P : toPlayer(): đóng gói Player
P --> PAD : Player
PAD --> LA : Player
LA -> SD : save()
LA -> LPD : saveOrUpdate()
LA -> LA : runOnUiThread(): openHome()
LA -> MA : startActivity()
MA --> U : hiển thị giao diện chính
@enduml
