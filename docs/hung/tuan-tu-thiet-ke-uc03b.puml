@startuml tuan-tu-thiet-ke-uc03b
!include _seq.iuml
title Tuần tự thiết kế – Chơi online, đoạn B: Nhận lời thách đấu

actor "Người chơi" as U
box "Client (Android)" #FFFFFF
boundary "OnlineActivity" as OA
boundary "MatchActivity" as GA
control "ChallengeFirebaseDAO" as CFD
control "MatchApiDAO" as MAD
entity "Challenge" as C
entity "Match" as M
end box
box "Server (Spring Boot)" #FFFFFF
boundary "MatchRestController" as MRC
control "MatchDAO" as MD
control "ProblemDAO" as PRD
control "FirebaseAdminDAO" as FAD
entity "Player" as SP
entity "Match" as SM
entity "MathProblem" as SQ
end box

CFD -> CFD : onDataChange()
CFD -> C : call
C -> C : Challenge()
C --> CFD : return
CFD -> OA : onChallengeChanged() {ChallengeCallback}
OA -> OA : showChallengeDialog()
OA --> U : display
U -> OA : nhấn Đồng ý
OA -> OA : onClick()
OA -> MAD : createMatch() {Thread}
MAD -> MRC : POST /api/matches → create()
MRC -> FAD : readPresence()
FAD -> SP : call
SP -> SP : Player()
SP --> FAD : return
FAD --> MRC : return
MRC -> FAD : readChallengeStatus()
FAD --> MRC : return
MRC -> MRC : startMatch()
MRC -> SM : call
SM -> SM : Match()
SM --> MRC : return
MRC -> PRD : generateProblems()
PRD -> SQ : call
SQ -> SQ : MathProblem()
SQ --> PRD : return
PRD --> MRC : return
MRC -> MD : insert()
MD --> MRC : return
MRC -> FAD : writeMatch()
MRC -> FAD : updateStatus()
MRC -> FAD : updateChallenge()
MRC --> MAD : return
MAD -> M : call
M -> M : Match()
M --> MAD : return
MAD --> OA : return
OA -> GA : openMatch()
GA --> U : display
@enduml
