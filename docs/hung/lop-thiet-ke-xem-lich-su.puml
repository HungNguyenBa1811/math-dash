@startuml lop-thiet-ke-xem-lich-su
!include _theme.iuml
title Biểu đồ lớp chi tiết – Xem lịch sử đấu

package "Client (Android)" as PC {
  abstract class BaseActivity <<boundary>> {
    # me : Player
    # onCreate(savedInstanceState : Bundle) : void
    + onClick(v : View) : void
  }
  class HistoryActivity <<boundary>> {
    - matches : List<Match>
    - loadHistory() : void
    - showSummary(matches : List<Match>) : void
    + onMatchClick(match : Match) : void
  }
  class "activity_history.xml" as xmlHistory
  class SessionDAO <<control>> {
    - prefs : SharedPreferences
    + SessionDAO(context : Context)
    + getPlayer() : Player
  }
  abstract class ApiDAO <<control>> {
    # request(method : String, path : String, body : JSONObject) : String
  }
  class MatchApiDAO <<control>> {
    + MatchApiDAO()
    + getHistory(playerId : int) : List<Match>
    - toMatch(json : JSONObject) : Match
  }
}

package "Common (Java Library)" as PM {
  class Player <<entity>> {
    - id : int
    - displayName : String
  }
  class Match <<entity>> {
    - id : int
    - endedAt : Date
    - players : List<MatchPlayer>
    + getOpponent(playerId : int) : MatchPlayer
    + getResult(playerId : int) : String
    + getPoints(playerId : int) : double
    + {static} judge(myCorrect : int, myTime : long, otherCorrect : int, otherTime : long) : String
  }
  class MatchPlayer <<entity>> {
    - id : int
    - correctCount : int
    - forfeited : boolean
    - player : Player
  }
}

package "Server (Spring Boot)" as PS {
  class MatchRestController <<boundary>> {
    + getHistory(playerId : int) : List<Match>
  }
  class MatchDAO <<control>> {
    + findByPlayer(playerId : int) : List<Match>
  }
  abstract class "DAO" as SDAO <<control>> {
    # conn : Connection
    + DAO()
  }
}

HistoryActivity --|> BaseActivity
BaseActivity o-- "1" Player
BaseActivity -- SessionDAO
HistoryActivity -- xmlHistory
HistoryActivity -- MatchApiDAO
HistoryActivity o-- "n" Match
MatchApiDAO --|> ApiDAO
SessionDAO -- Player
MatchApiDAO -- Match
Match "1" o-- "2" MatchPlayer
MatchPlayer "n" o-- "1" Player

MatchRestController -- MatchDAO
MatchDAO --|> SDAO
MatchDAO -- Match

MatchApiDAO -- MatchRestController : HTTP/JSON

' Client trên, Common giữa, Server dưới
PC -[hidden]down- PM
PM -[hidden]down- PS
@enduml
