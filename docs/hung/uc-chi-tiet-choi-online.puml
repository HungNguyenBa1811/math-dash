@startuml uc-chi-tiet-choi-online
!pragma layout smetana
' === VP Base Theme v2 ===
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam arrowColor #000000
skinparam lineColor #000000
hide circle

skinparam usecase {
  BackgroundColor #7ACFF5
  BorderColor Black
  FontColor Black
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor Black
}

left to right direction
title Biểu đồ use case chi tiết module Chơi online – Math Dash 1v1

actor "Người chơi" as A1

rectangle "Module Chơi online" {
  usecase "Chơi online" as UC03
  usecase "Xem bảng xếp hạng" as UC04
  usecase "Xem danh sách người chơi online" as DS
  usecase "//Vào trận đấu//" as VTD
  usecase "Gửi lời thách đấu" as GUI
  usecase "Nhận lời thách đấu" as NHAN
  usecase "Từ chối lời thách đấu" as TC
  usecase "Thi đấu" as TD
  usecase "Thoát trận" as TT
  usecase "Chơi tiếp" as CT
}

A1 --> UC03
A1 --> UC04

UC03 ..> DS : <<include>>
UC03 ..> VTD : <<include>>
UC03 ..> TD : <<include>>
GUI --|> VTD
NHAN --|> VTD
TC ..> NHAN : <<extend>>
TT ..> TD : <<extend>>
CT ..> TD : <<extend>>
@enduml
