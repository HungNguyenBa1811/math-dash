@startuml tuan-tu-phan-tich-uc05c
!include _seq.iuml
title Tuần tự pha phân tích – Chơi online, đoạn C: Thi đấu

actor "Người chơi" as U
boundary OnlineGameView as GV
boundary MatchResultView as RV
boundary MainView as MV
entity Match as M
entity MatchPlayer as MP
entity GameSession as GS
entity MathProblem as MPr

GV -> M : watchMatch()
GV -> MPr : generateProblem()
MPr --> GV : câu hỏi
GV --> U : hiển thị điểm, đồng hồ, câu hỏi, bàn phím số
loop đến khi hết giờ
  U -> GV : nhập đáp án, nhấn OK
  GV -> GS : submitAnswer()
  GS --> GV : điểm mới
  GV -> MP : updateScore()
  MP --> GV : đã ghi điểm
  GV -> MPr : generateProblem()
  MPr --> GV : câu hỏi tiếp theo
  GV --> U : hiển thị điểm mới, câu hỏi mới
  M --> GV : trận mới
  GV --> U : hiển thị điểm đối thủ
end
GV --> U : khóa bàn phím, hiển thị thông báo chờ kết quả
GV -> M : finishMatch()
M --> GV : trận đã kết thúc
GV -> M : getResult()
M --> GV : kết quả
GV -> RV : gọi
RV --> U : hiển thị kết quả, tỉ số
U -> RV : nhấn Về menu
RV -> MV : gọi
MV --> U : hiển thị
@enduml
