@startuml tuan-tu-phan-tich-uc03c
!include _seq.iuml
title Tuần tự phân tích – Chơi online, đoạn C: Thi đấu

actor "Người chơi" as U
boundary MatchView as GV
boundary MatchResultView as RV
entity Match as M
entity MathProblem as Q

GV -> M : watchMatch()
M --> GV : trận đấu kèm đề bài
GV --> U : hiển thị ô thời gian, trạng thái đối thủ, 10 câu hỏi
U -> GV : chọn đáp án, nhấn Nộp bài
GV -> M : submitAnswers()
M -> Q : isCorrect()
Q --> M : đúng / sai
M --> GV : trận đã ghi nhận bài làm
GV --> U : hiển thị đã nộp bài, đang chờ đối thủ
M -> M : isOver()
M --> GV : trận đã kết thúc
GV -> RV : gọi
RV -> M : getResult()
M --> RV : kết quả trận
RV -> M : getFinishTime()
M --> RV : thời gian làm bài
RV -> M : getPoints()
M --> RV : điểm trận
RV --> U : hiển thị kết quả, điểm, câu hỏi chơi tiếp
@enduml
