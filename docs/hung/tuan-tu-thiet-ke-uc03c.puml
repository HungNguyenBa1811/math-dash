@startuml tuan-tu-thiet-ke-uc03c
!include _seq.iuml
title Tuần tự thiết kế – Chơi online, đoạn C: Thi đấu

actor "Người chơi A" as UA
box "Máy người chơi A (Android)" #FFFFFF
boundary "MatchActivity (A)" as GAa
control "MatchFirebaseDAO (A)" as MFDa
control "MatchApiDAO (A)" as MADa
entity "Match (A)" as Ma
end box
box "Server (Spring Boot)" #FFFFFF
boundary "MatchRestController" as MRC
control "MatchDAO" as MD
control "PlayerDAO" as PD
control "FirebaseAdminDAO" as FAD
entity "Match" as SM
end box
box "Máy người chơi B (Android)" #FFFFFF
control "MatchApiDAO (B)" as MADb
control "MatchFirebaseDAO (B)" as MFDb
entity "Match (B)" as Mb
boundary "MatchActivity (B)" as GAb
end box
actor "Người chơi B" as UB

GAa ->> MFDa : watchMatch()
MFDa -> MFDa : onDataChange()
MFDa -> Ma : call
Ma -> Ma : Match()
Ma --> MFDa : return
MFDa -> GAa : onSuccess() {MatchCallback}
GAa -> GAa : startMatch()
GAa --> UA : display
GAb ->> MFDb : watchMatch()
MFDb -> MFDb : onDataChange()
MFDb -> Mb : call
Mb -> Mb : Match()
Mb --> MFDb : return
MFDb -> GAb : onSuccess() {MatchCallback}
GAb -> GAb : startMatch()
GAb --> UB : display
loop 10 câu
  UA -> GAa : bấm một ô phương án
  GAa -> GAa : onClick()
  GAa --> UA : display
end
UA -> GAa : nhấn Nộp bài
GAa -> GAa : onClick()
GAa -> MADa : submit() {Thread}
MADa -> MRC : POST /api/matches/{id}/submit → submit()
MRC -> MD : findById()
MD -> SM : call
SM -> SM : Match()
SM --> MD : return
MD --> MRC : return
MRC -> MD : updateSubmission()
MD --> MRC : return
MRC -> FAD : writeSubmitted()
MRC --> MADa : return
MADa -> Ma : call
Ma -> Ma : Match()
Ma --> MADa : return
MADa --> GAa : return
GAa --> UA : display
loop 10 câu
  UB -> GAb : bấm một ô phương án
  GAb -> GAb : onClick()
  GAb --> UB : display
end
UB -> GAb : nhấn Nộp bài
GAb -> GAb : onClick()
GAb -> MADb : submit() {Thread}
MADb -> MRC : POST /api/matches/{id}/submit → submit()
MRC -> MD : findById()
MD -> SM : call
SM -> SM : Match()
SM --> MD : return
MD --> MRC : return
MRC -> MD : updateSubmission()
MD --> MRC : return
MRC -> FAD : writeSubmitted()
MRC -> MRC : endMatch()
MRC -> MD : updateEndedAt()
MD --> MRC : return
MRC -> PD : getTotalPoints()
PD --> MRC : return
MRC -> FAD : updatePoints()
MRC -> FAD : writeFinished()
MRC --> MADb : return
MADb -> Mb : call
Mb -> Mb : Match()
Mb --> MADb : return
MADb --> GAb : return
MFDa -> MFDa : onDataChange()
MFDa -> Ma : call
Ma -> Ma : Match()
Ma --> MFDa : return
MFDa -> GAa : onSuccess() {MatchCallback}
GAa -> GAa : loadResult()
GAa -> MADa : getById() {Thread}
MADa -> MRC : GET /api/matches/{id} → getById()
MRC -> MD : findById()
MD -> SM : call
SM -> SM : Match()
SM --> MD : return
MD --> MRC : return
MRC --> MADa : return
MADa -> Ma : call
Ma -> Ma : Match()
Ma --> MADa : return
MADa --> GAa : return
GAa --> UA : display
MFDb -> MFDb : onDataChange()
MFDb -> Mb : call
Mb -> Mb : Match()
Mb --> MFDb : return
MFDb -> GAb : onSuccess() {MatchCallback}
GAb -> GAb : loadResult()
GAb -> MADb : getById() {Thread}
MADb -> MRC : GET /api/matches/{id} → getById()
MRC -> MD : findById()
MD -> SM : call
SM -> SM : Match()
SM --> MD : return
MD --> MRC : return
MRC --> MADb : return
MADb -> Mb : call
Mb -> Mb : Match()
Mb --> MADb : return
MADb --> GAb : return
GAb --> UB : display
@enduml
