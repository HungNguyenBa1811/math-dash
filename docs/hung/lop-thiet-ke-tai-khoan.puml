@startuml lop-thiet-ke-tai-khoan
!include _theme.iuml
title Biểu đồ lớp chi tiết – Đăng nhập, đăng ký

package "Client (Android)" {
  class LoginActivity <<boundary>> {
    - edtUsername : EditText
    - edtPassword : EditText
    - btnLogin : Button
    - btnRegister : Button
    - sessionDAO : SessionDAO
    + onCreate(savedInstanceState : Bundle) : void
    + onClick(v : View) : void
    - login(username : String, password : String) : void
    - showError(message : String) : void
    - openHome(player : Player) : void
  }
  class RegisterActivity <<boundary>> {
    - edtUsername : EditText
    - edtPassword : EditText
    - edtConfirmPassword : EditText
    - edtDisplayName : EditText
    - btnRegister : Button
    + onCreate(savedInstanceState : Bundle) : void
    + onClick(v : View) : void
    - register(username : String, password : String, displayName : String) : void
    - showResult(message : String, success : boolean) : void
  }
  class MainActivity <<boundary>> {
    + onCreate(savedInstanceState : Bundle) : void
  }
  class "activity_login.xml" as xmlLogin
  class "activity_register.xml" as xmlRegister
  class "activity_main.xml" as xmlMain
  class SessionDAO <<control>> {
    - prefs : SharedPreferences
    + SessionDAO(context : Context)
    + save(player : Player) : void
    + getPlayer() : Player
    + clear() : void
  }
  abstract class DAO <<control>> {
    # {static} con : SQLiteDatabase
    + DAO(context : Context)
  }
  class "PlayerDAO" as LPlayerDAO <<control>> {
    + PlayerDAO(context : Context)
    + saveOrUpdate(player : Player) : void
  }
  abstract class ApiDAO <<control>> {
    # {static} BASE_URL : String
    # post(path : String, body : JSONObject) : JSONObject
  }
  class PlayerApiDAO <<control>> {
    + register(username : String, password : String, displayName : String) : void
    + login(username : String, password : String) : Player
    - toPlayer(json : JSONObject) : Player
  }
  class Player <<entity>> {
    - id : int
    - username : String
    - displayName : String
    - role : String
  }
}

package "Server (Spring Boot)" {
  class AuthRestController <<boundary>> {
    - playerDAO : PlayerDAO
    - encoder : BCryptPasswordEncoder
    + register(body : Map<String, String>) : void
    + login(body : Map<String, String>) : Player
  }
  abstract class "DAO" as SDAO <<control>> {
    # {static} conn : Connection
    + DAO()
  }
  class PlayerDAO <<control>> {
    + findByUsername(username : String) : Player
    + insert(player : Player) : boolean
  }
  class "Player" as SPlayer <<entity>> {
    - id : int
    - username : String
    - passwordHash : String
    - displayName : String
    - role : String
    - createdAt : Date
  }
}

LoginActivity -- RegisterActivity
LoginActivity -- MainActivity
LoginActivity -- xmlLogin
RegisterActivity -- xmlRegister
MainActivity -- xmlMain
LoginActivity -- SessionDAO
LoginActivity -- LPlayerDAO
LoginActivity -- PlayerApiDAO
RegisterActivity -- PlayerApiDAO
LPlayerDAO --|> DAO
PlayerApiDAO --|> ApiDAO
SessionDAO -- Player
LPlayerDAO -- Player
PlayerApiDAO -- Player

AuthRestController -- PlayerDAO
PlayerDAO --|> SDAO
PlayerDAO -- SPlayer
AuthRestController -- SPlayer

PlayerApiDAO -- AuthRestController : HTTP/JSON
@enduml
