@startuml csdl-mysql
!pragma layout smetana
' === VP Base Theme v2 ===
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam arrowColor #000000
skinparam lineColor #000000
hide circle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 11
  AttributeFontSize 10
}
skinparam packageStyle rectangle
left to right direction
title Biểu đồ thiết kế CSDL MySQL – phần Chơi online
package "MySQL (backend)" {
  entity "tblPlayer" as SP {
    * id : integer(10) <<PK>>
    --
    * username : varchar(255) <<UNIQUE>>
    * passwordHash : varchar(255)
    * displayName : varchar(255)
    * createdAt : datetime
  }
  entity "tblMatch" as SM {
    * id : integer(10) <<PK>>
    --
    * roomCode : varchar(6)
    * questionSeed : bigint(20)
    * createdAt : datetime
    * endedAt : datetime
  }
  entity "tblMatchPlayer" as SMP {
    * id : integer(10) <<PK>>
    --
    * score : integer(10)
    * forfeited : tinyint(1)
    * tblMatchId : integer(10) <<FK>>
    * tblPlayerId : integer(10) <<FK>>
  }
}
SM ||--|{ SMP : "1 - 2"
SP ||--o{ SMP : "1 - n"
@enduml
