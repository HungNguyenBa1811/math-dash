@startuml uc-chi-tiet-tai-khoan
!pragma layout smetana
' === VP Base Theme v2 ===
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam arrowColor #000000
skinparam lineColor #000000
hide circle

skinparam usecase {
  BackgroundColor #7ACFF5
  BorderColor Black
  FontColor Black
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor Black
}

left to right direction
title Biểu đồ use case chi tiết module Tài khoản – Math Dash 1v1

actor "Người chơi" as A1
actor "Quản trị viên" as A2

rectangle "Module Tài khoản" {
  usecase "Đăng ký" as UC01
  usecase "Đăng nhập" as UC02
  usecase "Kiểm tra tài khoản" as KT
  usecase "Ghi nhớ phiên đăng nhập" as GN
}

A1 --> UC01
A1 --> UC02
UC02 <-- A2
UC02 ..> KT : <<include>>
UC02 ..> GN : <<include>>
@enduml
