@startuml tuan-tu-thiet-ke-uc06
!include _seq.iuml
title Tuần tự thiết kế – Xem lịch sử đấu

actor "Người chơi" as U
box "Client (Android)" #FFFFFF
boundary MainActivity as MA
boundary HistoryActivity as HA
boundary HistoryAdapter as AD
control SessionDAO as SD
control MatchApiDAO as MAD
entity Player as P
entity Match as M
end box
box "Server (Spring Boot)" #FFFFFF
boundary MatchRestController as MRC
control MatchDAO as MD
entity "Match" as SM
end box

U -> MA : nhấn Lịch sử đấu
MA -> HA : onClick(): startActivity()
HA -> SD : onCreate(): getPlayer()
SD -> P : đóng gói Player
P --> SD : Player
SD --> HA : Player
HA -> HA : loadHistory()
HA -> MAD : getHistory() {Thread}
MAD -> MRC : GET /api/matches → getByPlayer()
MRC -> MD : findByPlayer()
MD -> MD : truy vấn các trận của người chơi
MD -> SM : đóng gói Match
SM --> MD : Match
MD --> MRC : List<Match>
MRC --> MAD : List<Match> (JSON)
MAD -> M : toMatch()
M --> MAD : Match
MAD --> HA : List<Match>
HA -> AD : runOnUiThread(): tạo HistoryAdapter
loop mỗi dòng
  AD -> M : onBindViewHolder(): getResult()
  M --> AD : kết quả
end
HA --> U : hiển thị danh sách trận
U -> HA : nhấn quay lại
HA -> MA : finish()
MA --> U : hiển thị
@enduml
