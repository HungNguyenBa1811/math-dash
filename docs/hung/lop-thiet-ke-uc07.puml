@startuml lop-thiet-ke-uc07
!include _theme.iuml
title Biểu đồ lớp chi tiết – Quản lý bạn bè

package "Client (Android)" {
  class MainActivity <<boundary>> {
    - btnFriends : Button
    + onClick(v : View) : void
  }
  class FriendActivity <<boundary>> {
    - edtUsername : EditText
    - btnAddFriend : Button
    - txtRequestsTitle : TextView
    - rvRequests : RecyclerView
    - txtFriendsTitle : TextView
    - txtEmpty : TextView
    - rvFriends : RecyclerView
    - me : Player
    - requests : List<Friendship>
    - friends : List<Friendship>
    - onlineIds : Set<Integer>
    - requestAdapter : FriendRequestAdapter
    - friendAdapter : FriendAdapter
    - sessionDAO : SessionDAO
    - friendshipApiDAO : FriendshipApiDAO
    - presenceFirebaseDAO : PresenceFirebaseDAO
    + onCreate(savedInstanceState : Bundle) : void
    + onClick(v : View) : void
    + onDestroy() : void
    + onPlayersChanged(players : List<Player>) : void
    + onAccept(friendship : Friendship) : void
    + onReject(friendship : Friendship) : void
    + onUnfriend(friendship : Friendship) : void
    - loadFriendships() : void
    - showFriendships(list : List<Friendship>) : void
  }
  class FriendRequestAdapter <<boundary>> {
    - listFriendship : List<Friendship>
    - activity : FriendActivity
    + setFriendships(friendships : List<Friendship>) : void
    + onCreateViewHolder(parent : ViewGroup, viewType : int) : FriendRequestViewHolder
    + onBindViewHolder(holder : FriendRequestViewHolder, position : int) : void
    + getItemCount() : int
  }
  class FriendRequestViewHolder <<boundary>> {
    - txtName : TextView
    - btnAccept : Button
    - btnReject : Button
  }
  class FriendAdapter <<boundary>> {
    - listFriendship : List<Friendship>
    - playerId : int
    - onlineIds : Set<Integer>
    - activity : FriendActivity
    + setFriendships(friendships : List<Friendship>) : void
    + setOnlineIds(onlineIds : Set<Integer>) : void
    + onCreateViewHolder(parent : ViewGroup, viewType : int) : FriendViewHolder
    + onBindViewHolder(holder : FriendViewHolder, position : int) : void
    + getItemCount() : int
  }
  class FriendViewHolder <<boundary>> {
    - viewOnlineDot : View
    - txtName : TextView
    - txtPoints : TextView
    - txtStatus : TextView
    - btnUnfriend : ImageButton
  }
  class "activity_main.xml" as xmlMain
  class "activity_friend.xml" as xmlFriend
  class "item_friend_request.xml" as xmlItemRequest
  class "item_friend.xml" as xmlItemFriend

  interface PlayerListCallback {
    + onPlayersChanged(players : List<Player>) : void
  }
  class SessionDAO <<control>> {
    - prefs : SharedPreferences
    + SessionDAO(context : Context)
    + getPlayer() : Player
  }
  abstract class FirebaseDAO <<control>> {
    # {static} con : DatabaseReference
    + FirebaseDAO()
  }
  class PresenceFirebaseDAO <<control>> {
    + watchOnlinePlayers(callback : PlayerListCallback) : void
    + stopWatching() : void
    - toPlayer(id : String, data : DataSnapshot) : Player
  }
  abstract class ApiDAO <<control>> {
    # {static} BASE_URL : String
    # get(path : String) : JSONObject
    # getArray(path : String) : JSONArray
    # post(path : String, body : JSONObject) : JSONObject
    # delete(path : String) : void
  }
  class FriendshipApiDAO <<control>> {
    + getFriendships(playerId : int) : List<Friendship>
    + sendRequest(senderId : int, receiverUsername : String) : Friendship
    + accept(friendshipId : int, playerId : int) : Friendship
    + delete(friendshipId : int, playerId : int) : void
    - toFriendship(json : JSONObject) : Friendship
    - toPlayer(json : JSONObject) : Player
  }
  class Friendship <<entity>> {
    - id : int
    - status : String
    - createdAt : Date
    - sender : Player
    - receiver : Player
    + getFriend(playerId : int) : Player
    + canAccept(playerId : int) : boolean
  }
  class Player <<entity>> {
    - id : int
    - username : String
    - displayName : String
    - totalPoints : double
    - status : String
  }
}

package "Server (Spring Boot)" {
  class FriendshipRestController <<boundary>> {
    - friendshipDAO : FriendshipDAO
    - playerDAO : PlayerDAO
    + getFriendships(playerId : int) : List<Friendship>
    + sendRequest(body : Map<String, String>) : Friendship
    + accept(id : int, playerId : int) : Friendship
    + delete(id : int, playerId : int) : void
  }
  abstract class "DAO" as SDAO <<control>> {
    # {static} conn : Connection
    + DAO()
  }
  class FriendshipDAO <<control>> {
    + findByPlayer(playerId : int) : List<Friendship>
    + findById(id : int) : Friendship
    + existsBetween(playerId1 : int, playerId2 : int) : boolean
    + insert(friendship : Friendship) : boolean
    + updateStatus(id : int, status : String) : boolean
    + delete(id : int) : boolean
    - toFriendship(rs : ResultSet) : Friendship
  }
  class PlayerDAO <<control>> {
    + findById(id : int) : Player
    + findByUsername(username : String) : Player
    + getTotalPoints(playerId : int) : double
  }
  class "Friendship" as SFriendship <<entity>> {
    - id : int
    - status : String
    - createdAt : Date
    - sender : Player
    - receiver : Player
    + getFriend(playerId : int) : Player
    + canAccept(playerId : int) : boolean
  }
  class "Player" as SPlayer <<entity>> {
    - id : int
    - username : String
    - passwordHash : String
    - displayName : String
    - role : String
    - totalPoints : double
  }
}

MainActivity -- FriendActivity
FriendActivity -- FriendRequestAdapter
FriendActivity -- FriendAdapter
FriendRequestAdapter -- FriendRequestViewHolder
FriendAdapter -- FriendViewHolder
MainActivity -- xmlMain
FriendActivity -- xmlFriend
FriendRequestViewHolder -- xmlItemRequest
FriendViewHolder -- xmlItemFriend
FriendActivity ..|> PlayerListCallback
FriendActivity o-- "1" Player
FriendActivity o-- "n" Friendship
FriendRequestAdapter o-- "n" Friendship
FriendAdapter o-- "n" Friendship
FriendActivity -- SessionDAO
FriendActivity -- FriendshipApiDAO
FriendActivity -- PresenceFirebaseDAO
PresenceFirebaseDAO --|> FirebaseDAO
FriendshipApiDAO --|> ApiDAO
SessionDAO -- Player
PresenceFirebaseDAO -- Player
FriendshipApiDAO -- Friendship
Friendship "n" o-- "1" Player : sender
Friendship "n" o-- "1" Player : receiver

FriendshipRestController -- FriendshipDAO
FriendshipRestController -- PlayerDAO
FriendshipDAO --|> SDAO
PlayerDAO --|> SDAO
FriendshipDAO -- SFriendship
PlayerDAO -- SPlayer
FriendshipRestController -- SFriendship
SFriendship "n" o-- "1" SPlayer : sender
SFriendship "n" o-- "1" SPlayer : receiver

FriendshipApiDAO -- FriendshipRestController : HTTP/JSON
@enduml
