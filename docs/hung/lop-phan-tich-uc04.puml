@startuml lop-phan-tich-uc04
!include _theme.iuml
title Biểu đồ lớp pha phân tích – Xem lịch sử đấu

class MainView <<boundary>> {
  - outMyInfo
  - subHistory
}
class HistoryView <<boundary>> {
  - outWinRateChart
  - outSummary
  - outsubListMatch
  - subTabRanking
  - outListRanking
}
class MatchDetailView <<boundary>> {
  - outResult
  - outPoints
  - outMyResult
  - outOpponentResult
  - outListProblem
}
class Player <<entity>> {
  - username
  - displayName
  - totalPoints
  - avgOpponentPoints
  - avgWinTime
  + getRanking()
}
class Match <<entity>> {
  - startedAt
  - endedAt
  + getHistory()
  + getMatch()
  + getOpponent()
  + getResult()
  + getFinishTime()
  + getPoints()
}
class MatchPlayer <<entity>> {
  - correctCount
  - submittedAt
  - forfeited
}
class MathProblem <<entity>> {
  - operand1
  - operand2
  - operator
  - correctAnswer
}

MainView -- HistoryView
HistoryView -- MatchDetailView
HistoryView -- Match
HistoryView -- Player
MatchDetailView -- Match
Player "n" -- "n" Match
(Player, Match) .. MatchPlayer
Match "1" *-- "10" MathProblem
@enduml
