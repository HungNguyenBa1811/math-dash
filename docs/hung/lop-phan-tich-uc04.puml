@startuml lop-phan-tich-uc04
!include _theme.iuml
title Biểu đồ lớp pha phân tích – Xem bảng xếp hạng

class MainView <<boundary>> {
  - outMyInfo
  - subRanking
}
class RankingView <<boundary>> {
  - outListRanking
}
class Player <<entity>> {
  - username
  - displayName
  - totalPoints
  - avgOpponentPoints
  - avgWinTime
  + getRanking()
}
class Match <<entity>> {
  - startedAt
  - endedAt
  + getResult()
  + getFinishTime()
  + getPoints()
}
class MatchPlayer <<entity>> {
  - correctCount
  - submittedAt
  - forfeited
}

MainView -- RankingView
RankingView -- Player
Player "n" -- "n" Match
(Player, Match) .. MatchPlayer
@enduml
