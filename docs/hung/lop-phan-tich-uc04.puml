@startuml lop-phan-tich-uc04
!include _theme.iuml
title Biểu đồ lớp pha phân tích – Xem lịch sử đấu

class OnlineView <<boundary>> {
  - outMyInfo
  - subHistory
  - subRanking
}
class HistoryView <<boundary>> {
  - outWinRateChart
  - outSummary
  - outsubListMatch
  - subTabRanking
  - outListRanking
}
class MatchDetailView <<boundary>> {
  - outResult
  - outPoints
  - outMyResult
  - outOpponentResult
  - outListAnswer
}
class Player <<entity>> {
  - username
  - displayName
  - totalPoints
  - avgOpponentPoints
  - avgWinTime
  + getRanking()
}
class Match <<entity>> {
  - startedAt
  - endedAt
  + getHistory()
  + getMatch()
  + getOpponent()
  + getResult()
  + getFinishTime()
  + getPoints()
}
class MatchPlayer <<entity>> {
  - correctCount
  - submittedAt
  - forfeited
}
class Answer <<entity>> {
  - selectedOption
  - answerTime
  + isCorrect()
}
class MathProblem <<entity>> {
  - operand1
  - operand2
  - operator
  - correctAnswer
  + isCorrect()
}

OnlineView -- HistoryView
HistoryView -- MatchDetailView
HistoryView -- Match
HistoryView -- Player
MatchDetailView -- Match
MatchDetailView -- Answer
Player "n" -- "n" Match
(Player, Match) .. MatchPlayer
Match "1" o-- "10" MathProblem
MatchPlayer "n" -- "n" MathProblem
(MatchPlayer, MathProblem) .. Answer
@enduml
