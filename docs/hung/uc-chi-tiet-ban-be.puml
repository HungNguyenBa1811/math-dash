@startuml uc-chi-tiet-ban-be
!pragma layout smetana
' === VP Base Theme v2 ===
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam arrowColor #000000
skinparam lineColor #000000
hide circle

skinparam usecase {
  BackgroundColor #7ACFF5
  BorderColor Black
  FontColor Black
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor Black
}

left to right direction
title Biểu đồ use case chi tiết module Bạn bè – Math Dash 1v1

actor "Người chơi" as A1

rectangle "Module Bạn bè" {
  usecase "Quản lý bạn bè" as UC07
  usecase "Xem danh sách bạn bè" as DS
  usecase "Gửi lời mời kết bạn" as GUI
  usecase "Đồng ý lời mời kết bạn" as DY
  usecase "Từ chối lời mời kết bạn" as TC
  usecase "Hủy kết bạn" as HUY
}

A1 --> UC07

UC07 ..> DS : <<include>>
GUI ..> UC07 : <<extend>>
DY ..> UC07 : <<extend>>
TC ..> UC07 : <<extend>>
HUY ..> UC07 : <<extend>>
@enduml
