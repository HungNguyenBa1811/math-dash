@startuml tuan-tu-phan-tich-uc06
!include _seq.iuml
title Tuần tự pha phân tích – Xem lịch sử đấu

actor "Người chơi" as U
boundary MainView as MV
boundary HistoryView as HV
entity Match as M

U -> MV : nhấn Lịch sử đấu
MV -> HV : gọi
HV -> M : getHistory()
M --> HV : danh sách trận
loop mỗi trận
  HV -> M : getResult()
  M --> HV : kết quả
end
HV --> U : hiển thị danh sách trận
U -> HV : nhấn quay lại
HV -> MV : gọi
MV --> U : hiển thị
@enduml
