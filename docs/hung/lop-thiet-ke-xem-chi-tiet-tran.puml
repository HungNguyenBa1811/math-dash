@startuml lop-thiet-ke-xem-chi-tiet-tran
!include _theme.iuml
title Biểu đồ lớp chi tiết – Xem chi tiết trận

package "Client (Android)" as PC {
  abstract class BaseActivity <<boundary>> {
    # me : Player
    # onCreate(savedInstanceState : Bundle) : void
    + onClick(v : View) : void
  }
  class MatchDetailActivity <<boundary>> {
    - match : Match
    - matchId : int
    - loadMatch() : void
  }
  class "activity_match_detail.xml" as xmlDetail
  class SessionDAO <<control>> {
    - prefs : SharedPreferences
    + SessionDAO(context : Context)
    + getPlayer() : Player
  }
  abstract class ApiDAO <<control>> {
    # request(method : String, path : String, body : JSONObject) : String
  }
  class MatchApiDAO <<control>> {
    + MatchApiDAO()
    + getById(matchId : int) : Match
    - toMatch(json : JSONObject) : Match
  }
}

package "Common (Java Library)" as PM {
  class Player <<entity>> {
    - id : int
    - displayName : String
    - totalPoints : double
  }
  class Match <<entity>> {
    - id : int
    - endedAt : Date
    - questions : List<MathProblem>
    - players : List<MatchPlayer>
    + getOpponent(playerId : int) : MatchPlayer
    + getFinishTime(playerId : int) : long
    + getResult(playerId : int) : String
    + getPoints(playerId : int) : double
    + {static} judge(myCorrect : int, myTime : long, otherCorrect : int, otherTime : long) : String
  }
  class MatchPlayer <<entity>> {
    - id : int
    - answers : List<Answer>
    - correctCount : int
    - submittedAt : Date
    - forfeited : boolean
    - player : Player
  }
  class MathProblem <<entity>> {
    - id : int
    - operand1 : int
    - operand2 : int
    - operator : String
    - correctAnswer : int
    + isCorrect(answer : int) : boolean
    + getExpression() : String
  }
  class Answer <<entity>> {
    - id : int
    - selectedOption : int
    - answerTime : long
    - problem : MathProblem
    + isAnswered() : boolean
    + isCorrect() : boolean
  }
}

package "Server (Spring Boot)" as PS {
  class MatchRestController <<boundary>> {
    + getById(id : int) : Match
  }
  class MatchDAO <<control>> {
    + findById(id : int) : Match
    - findAnswers(matchPlayerId : int, questions : List<MathProblem>) : List<Answer>
  }
  class PlayerDAO <<control>> {
    + getTotalPoints(playerId : int) : double
  }
  abstract class "DAO" as SDAO <<control>> {
    # conn : Connection
    + DAO()
  }
}

MatchDetailActivity --|> BaseActivity
BaseActivity o-- "1" Player
BaseActivity -- SessionDAO
MatchDetailActivity -- xmlDetail
MatchDetailActivity -- MatchApiDAO
MatchDetailActivity o-- "1" Match
MatchApiDAO --|> ApiDAO
SessionDAO -- Player
MatchApiDAO -- Match
Match "1" o-- "2" MatchPlayer
Match "1" o-- "10" MathProblem
MatchPlayer "n" o-- "1" Player
MatchPlayer "1" o-- "n" Answer
MathProblem "1" --o "n" Answer

MatchRestController -- MatchDAO
MatchRestController -- PlayerDAO
PlayerDAO -- MatchDAO
MatchDAO --|> SDAO
PlayerDAO --|> SDAO
MatchDAO -- Match
PlayerDAO -- Player
PlayerDAO -- Match

MatchApiDAO -- MatchRestController : HTTP/JSON

' Client trên, Common giữa, Server dưới
PC -[hidden]down- PM
PM -[hidden]down- PS
@enduml
