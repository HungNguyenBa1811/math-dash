@startuml csdl
!pragma layout smetana
' === VP Base Theme v2 ===
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam arrowColor #000000
skinparam lineColor #000000
hide circle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontSize 11
  AttributeFontSize 10
}
skinparam packageStyle rectangle
title Biểu đồ thiết kế CSDL – Math Dash 1v1

package "MySQL (server)" {
  entity "tblPlayer" as SP {
    * id : integer(10) <<PK>>
    --
    * username : varchar(255) <<UNIQUE>>
    * passwordHash : varchar(255)
    * displayName : varchar(255)
    * role : varchar(10)
    * createdAt : datetime
  }
  entity "tblMatch" as SM {
    * id : integer(10) <<PK>>
    --
    * startedAt : datetime(3)
    endedAt : datetime(3)
  }
  entity "tblMathProblem" as SQ {
    * id : integer(10) <<PK>>
    --
    * operand1 : integer(10)
    * operand2 : integer(10)
    * operator : varchar(1)
    * correctAnswer : integer(10)
    * option1 : integer(10)
    * option2 : integer(10)
    * option3 : integer(10)
    * option4 : integer(10)
    * tblMatchId : integer(10) <<FK>>
  }
  entity "tblMatchPlayer" as SMP {
    * id : integer(10) <<PK>>
    --
    * correctCount : integer(10)
    submittedAt : datetime(3)
    * forfeited : tinyint(1)
    * tblMatchId : integer(10) <<FK>>
    * tblPlayerId : integer(10) <<FK>>
  }
}

package "SQLite (app)" {
  entity "tblPlayer (bản sao)" as AP {
    * id : integer <<PK>>
    --
    * username : text
    * displayName : text
  }
  entity "tblBotGame" as ABG {
    * id : integer <<PK>>
    --
    * difficulty : integer
    * correctCount : integer
    * finishTime : integer
    * botCorrectCount : integer
    * botFinishTime : integer
    * playedAt : text
    * tblPlayerId : integer <<FK>>
  }
}

SM ||--|{ SMP : "1 - 2"
SM ||--|{ SQ : "1 - 10"
SP ||--o{ SMP : "1 - n"
AP ||--o{ ABG : "1 - n"
@enduml
