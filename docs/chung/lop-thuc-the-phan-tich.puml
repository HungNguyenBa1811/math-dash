@startuml lop-thuc-the-phan-tich
!pragma layout smetana
' === VP Base Theme v2 ===
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam arrowColor #000000
skinparam lineColor #000000
hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
  FontSize 11
  AttributeFontSize 10
  BorderThickness 1
}
left to right direction
title Biểu đồ lớp thực thể pha phân tích – Math Dash 1v1

class Player {
  - username
  - password
  - displayName
  - createdAt
}
class GameConfig {
  - soundEnabled
  - vibrationEnabled
  - secondsPerQuestion
}
class MathProblem {
  - operand1
  - operand2
  - operator
  - correctAnswer
  - answerOptions
}
class GameSession {
  - difficulty
  - score
  - currentStreak
  - maxStreak
  - livesLeft
  - correctCount
  - wrongCount
  - gameOver
}
class GameRecord {
  - difficulty
  - score
  - maxStreak
  - correctCount
  - wrongCount
  - playedAt
}
class Match {
  - roomCode
  - status
  - questionSeed
  - createdAt
  - endedAt
}
class MatchPlayer {
  - score
  - forfeited
}

' Thông tin A nằm trong B: hình thoi rỗng đặt ở B
GameSession "n" o-- "1" Player
GameRecord "n" o-- "1" Player
GameSession "n" o-- "1" GameConfig
' Câu hỏi chỉ tồn tại trong ván chơi: hình thoi đặc
GameSession "1" *-- "n" MathProblem

' Quan hệ n-n Người chơi – Trận đấu (mỗi trận đúng 2 người), lớp liên kết MatchPlayer
Player "n" -- "2" Match
(Player, Match) .. MatchPlayer
@enduml
