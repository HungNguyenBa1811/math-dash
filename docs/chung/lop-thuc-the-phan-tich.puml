@startuml lop-thuc-the-phan-tich
!pragma layout smetana
' === VP Base Theme v2 ===
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam arrowColor #000000
skinparam lineColor #000000
hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
  FontSize 11
  AttributeFontSize 10
  BorderThickness 1
}
left to right direction
title Biểu đồ lớp thực thể pha phân tích – Math Dash 1v1

class Player {
  - username
  - password
  - displayName
  - role
  - createdAt
  - totalPoints
  - avgOpponentPoints
  - avgWinTime
  - status
}
class MathProblem {
  - operand1
  - operand2
  - operator
  - correctAnswer
  - answerOptions
}
class Challenge {
  - status
  - createdAt
}
class Match {
  - status
  - startedAt
  - endedAt
}
class MatchPlayer {
  - answers
  - correctCount
  - submittedAt
  - forfeited
}
class BotGame {
  - difficulty
  - correctCount
  - finishTime
  - botCorrectCount
  - botFinishTime
  - playedAt
}
class Friendship {
  - status
  - createdAt
}

Challenge "n" o-- "1" Player : người mời
Challenge "n" o-- "1" Player : người được mời
Player "n" -- "n" Match
(Player, Match) .. MatchPlayer
Match "1" *-- "10" MathProblem
BotGame "n" o-- "1" Player
BotGame "1" *-- "10" MathProblem
Friendship "n" o-- "1" Player : người gửi
Friendship "n" o-- "1" Player : người nhận
@enduml
